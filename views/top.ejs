<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Топ статей</title>
    <style>
        body { background: #1a1a1a; font-family: Arial; padding: 40px; color: #ddd; }
        .container { max-width: 1000px; margin: auto; background: #2d2d2d; padding: 30px; border-radius: 16px; }
        .article { background: #242424; padding: 15px; margin: 15px 0; border-left: 4px solid #888; }
        button { background: #3a3a3a; color: white; padding: 10px 20px; border: none; border-radius: 8px; cursor: pointer; }
        a { color: #aaa; text-decoration: none; }
    </style>
</head>
<body>
<div class="container">
    <h1>🏆 Топ статей (по рейтингу и комментариям)</h1>
    <% if (topArticles.length === 0) { %>
        <p>Нет статей.</p>
    <% } else { %>
        <% topArticles.forEach((article, idx) => { %>
            <div class="article">
                <h3><%= idx+1 %>. <%= article.title %></h3>
                <p><strong>Авторы:</strong> <%= article.authors.join(', ') %></p>
                <p><strong>Дата:</strong> <%= new Date(article.date).toLocaleDateString('ru-RU') %></p>
                <p><strong>Средний рейтинг:</strong> <%= article.avgRating.toFixed(1) %>/10</p>
                <p><strong>Количество комментариев:</strong> <%= article.commentsCount %></p>
                <a href="/article/<%= article._id %>"><button>Открыть</button></a>
            </div>
        <% }); %>
    <% } %>
    <a href="/"><button>← На главную</button></a>
</div>
</body>
</html>